# Généré par Ansible (roles/app) : ne pas modifier sur le serveur, changer group_vars puis relancer deploy.yml.
API_DOMAIN={{ api_domain }}
ADMIN_DOMAIN={{ admin_domain }}
ACME_EMAIL={{ acme_email }}
ADMIN_ALLOWED_IPS={{ admin_allowed_ips }}
{% if app_image_tag %}

# Images de la CI
API_IMAGE={{ app_image_registry | lower }}/beninconnect-api:{{ app_image_tag }}
ADMIN_IMAGE={{ app_image_registry | lower }}/beninconnect-admin:{{ app_image_tag }}
{% endif %}

DB_HOST={{ db_host }}
DB_PORT={{ db_port }}
DB_NAME={{ db_name }}
DB_USER={{ db_user }}
DB_PASSWORD={{ vault_db_password }}
DB_SSLMODE={{ db_sslmode }}
DB_POOL_SIZE={{ db_pool_size }}

MINIO_ROOT_USER={{ minio_root_user }}
MINIO_ROOT_PASSWORD={{ vault_minio_root_password }}
{% if s3_service_url %}
S3_SERVICE_URL={{ s3_service_url }}
S3_REGION={{ s3_region }}
S3_BUCKET={{ s3_bucket }}
S3_ACCESS_KEY={{ vault_s3_access_key }}
S3_SECRET_KEY={{ vault_s3_secret_key }}
S3_CREATE_BUCKET=false
{% endif %}
S3_PUBLIC_BASE_URL={{ s3_public_base_url }}

JWT_SIGNING_KEY={{ vault_jwt_signing_key }}

SMTP_HOST={{ smtp_host }}
SMTP_PORT={{ smtp_port }}
SMTP_USERNAME={{ smtp_username }}
SMTP_PASSWORD={{ vault_smtp_password }}
SMTP_FROM={{ smtp_from }}

ADMIN_BOOTSTRAP_EMAIL={{ admin_bootstrap_email }}
ADMIN_BOOTSTRAP_PASSWORD={{ vault_admin_bootstrap_password }}
