# Copier en vault.yml, remplir, puis chiffrer : ansible-vault encrypt group_vars/production/vault.yml
vault_db_password: "mot-de-passe-du-fournisseur"
vault_minio_root_password: "openssl rand -hex 24"
vault_jwt_signing_key: "openssl rand -base64 48"
vault_smtp_password: ""
# Laisser vide après la première connexion du SuperAdmin
vault_admin_bootstrap_password: "10 caracteres min, lettres et chiffres"
# Fournisseur S3 externe uniquement
vault_s3_access_key: ""
vault_s3_secret_key: ""
