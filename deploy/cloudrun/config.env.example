# Copier en config.env (jamais commité) puis adapter.
PROJECT_ID=beninconnect-prod
REGION=europe-west1                     # Belgique : accepte les domaines personnalisés Cloud Run (europe-west9 Paris : non)
REPO=beninconnect
BUCKET=beninconnect-prod-media          # photos envoyées (nom unique mondial)

# URL publiques (domaines personnalisés, ou URL *.run.app au premier déploiement)
API_URL=https://api.beninconnect.app
ADMIN_URL=https://admin.beninconnect.app

# Base : "cloudsql" (Cloud SQL du projet) ou "externe" (Neon, Supabase... chaîne complète dans le secret)
DB_MODE=cloudsql
CLOUDSQL_INSTANCE=beninconnect          # nom court de l'instance Cloud SQL
CLOUDSQL_TIER=db-f1-micro               # plus petit gabarit ; db-custom-1-3840 pour plus de charge

# Emails (port 587 : le port 25 est bloqué sur Google Cloud)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_FROM=no-reply@beninconnect.app

# Premier SuperAdmin (mot de passe dans le secret bc-admin-bootstrap-password)
ADMIN_BOOTSTRAP_EMAIL=hector@hbatechettrade.com

# Instances : 1 minimum évite le démarrage à froid (environ 10 €/mois), 0 = paiement à l'usage
API_MIN_INSTANCES=0
API_MAX_INSTANCES=4
