<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BeninConnect.App.Features.Messaging.ViewModels"
             x:Class="BeninConnect.App.Features.Messaging.Components.MessageBubble"
             x:DataType="vm:MessageItemViewModel">
  <StackPanel Spacing="4" Margin="0,2">
    <Border Classes="pill" HorizontalAlignment="Center" Margin="0,10,0,6" IsVisible="{Binding ShowDay}"
            Background="{DynamicResource SurfaceVariantBrush}">
      <TextBlock Text="{Binding DayText}" Foreground="{DynamicResource TextSecondaryBrush}" />
    </Border>

    <!-- Message envoyé -->
    <Border IsVisible="{Binding IsMine}"
            HorizontalAlignment="Right"
            MaxWidth="290"
            Background="{DynamicResource BubbleMineBrush}"
            CornerRadius="18,18,4,18"
            Padding="12,8">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="{DynamicResource OnBubbleMineBrush}" />
        <TextBlock Text="{Binding TimeText}" FontSize="11" Opacity="0.8" HorizontalAlignment="Right" Foreground="{DynamicResource OnBubbleMineBrush}" />
      </StackPanel>
    </Border>

    <!-- Message reçu -->
    <StackPanel IsVisible="{Binding IsTheirs}" HorizontalAlignment="Left" Spacing="2">
      <Border MaxWidth="290"
              Background="{DynamicResource BubbleOtherBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="18,18,18,4"
              Padding="12,8">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
          <TextBlock Classes="caption" Text="{Binding TimeText}" FontSize="11" HorizontalAlignment="Right" />
        </StackPanel>
      </Border>
      <TextBlock Classes="caption" FontSize="11" Margin="8,0,0,0" Text="Réponse simulée · démonstration" IsVisible="{Binding IsSimulated}" />
    </StackPanel>
  </StackPanel>
</UserControl>
