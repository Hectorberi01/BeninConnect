<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:BeninConnect.App.Shared.Controls"
             xmlns:sc="using:BeninConnect.App.Shared.Components"
             xmlns:vm="using:BeninConnect.App.Features.Messaging.ViewModels"
             xmlns:pvm="using:BeninConnect.App.Features.Profile.ViewModels"
             x:Class="BeninConnect.App.Features.Messaging.Views.NewConversationView"
             x:DataType="vm:NewConversationViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <sc:AppHeader Title="Nouveau message" BackCommand="{Binding GoBackCommand}" />
    <c:SearchBar Grid.Row="1" Margin="16,12,16,4" Text="{Binding SearchText}" Watermark="Rechercher un membre, une ville, un métier" />
    <Panel Grid.Row="2">
      <sc:LoadingState IsVisible="{Binding IsLoading}" />
      <sc:ErrorState IsVisible="{Binding IsError}" Message="{Binding ErrorMessage}" RetryCommand="{Binding RetryCommand}" />
      <ListBox ItemsSource="{Binding People}" IsVisible="{Binding IsContent}" Background="Transparent" Margin="8,4">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="pvm:UserItemViewModel">
            <sc:UserCard />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Panel>
  </Grid>
</UserControl>
