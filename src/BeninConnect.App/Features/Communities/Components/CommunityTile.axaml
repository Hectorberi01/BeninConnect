<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:BeninConnect.App.Core.Converters"
             xmlns:vm="using:BeninConnect.App.Features.Communities.ViewModels"
             x:Class="BeninConnect.App.Features.Communities.Components.CommunityTile"
             x:DataType="vm:CommunityItemViewModel">
  <!-- Vignette compacte pour les listes horizontales (suggestions, mes communautés). -->
  <Button Classes="bare" Width="150" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}">
    <Border Classes="card" Padding="0" ClipToBounds="True">
      <StackPanel>
        <Image Source="{Binding CoverImage, Converter={x:Static conv:AppConverters.AssetBitmap}}" Height="78" Stretch="UniformToFill" />
        <StackPanel Margin="10,8,10,10" Spacing="2">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" MaxLines="2" TextTrimming="WordEllipsis" Height="36" />
          <TextBlock Classes="caption" FontSize="12" Text="{Binding MemberCountText}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Button>
</UserControl>
