<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:BeninConnect.App.Core.Converters"
             xmlns:vm="using:BeninConnect.App.Features.Onboarding.ViewModels"
             x:Class="BeninConnect.App.Features.Onboarding.Views.OnboardingView"
             x:DataType="vm:OnboardingViewModel"
             Background="{DynamicResource SurfaceBrush}">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24,12,24,24">
    <Button Classes="link" HorizontalAlignment="Right" Content="Passer"
            Command="{Binding SkipCommand}" IsVisible="{Binding IsNotLast}" Margin="0,8" />

    <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="24">
      <Image Source="{Binding Current.ImagePath, Converter={x:Static conv:AppConverters.AssetBitmap}}"
             MaxHeight="300" Stretch="Uniform" HorizontalAlignment="Center" />
      <TextBlock Classes="h1" Text="{Binding Current.Title}" TextAlignment="Center" />
      <TextBlock Classes="body secondary" Text="{Binding Current.Description}" TextAlignment="Center" />
      <ItemsControl ItemsSource="{Binding Dots}" HorizontalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:OnboardingDot">
            <Panel>
              <Border Width="24" Height="8" CornerRadius="4" Background="{DynamicResource PrimaryBrush}" IsVisible="{Binding IsActive}" />
              <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource BorderBrush}" IsVisible="{Binding !IsActive}" />
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <Panel Grid.Row="2">
      <Button Classes="primary" HorizontalAlignment="Stretch" Content="Suivant"
              Command="{Binding NextCommand}" IsVisible="{Binding IsNotLast}" />
      <Button Classes="primary" HorizontalAlignment="Stretch" Content="Commencer"
              Command="{Binding StartCommand}" IsVisible="{Binding IsLast}" />
    </Panel>
  </Grid>
</UserControl>
