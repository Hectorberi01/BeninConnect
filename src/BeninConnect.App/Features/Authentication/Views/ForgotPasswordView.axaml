<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:BeninConnect.App.Shared.Controls"
             xmlns:sc="using:BeninConnect.App.Shared.Components"
             xmlns:vm="using:BeninConnect.App.Features.Authentication.ViewModels"
             x:Class="BeninConnect.App.Features.Authentication.Views.ForgotPasswordView"
             x:DataType="vm:ForgotPasswordViewModel"
             Background="{DynamicResource SurfaceBrush}">
  <Grid RowDefinitions="Auto,*">
    <sc:AppHeader Title="Mot de passe oublié" BackCommand="{Binding GoBackCommand}" />
    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="24,24,24,32" Spacing="18" MaxWidth="460">
        <StackPanel Spacing="18" IsVisible="{Binding IsFormVisible}">
          <TextBlock Classes="h2" Text="Réinitialiser le mot de passe" />
          <TextBlock Classes="body secondary" Text="Saisissez l'adresse email de votre compte. Nous vous enverrons un lien de réinitialisation (simulé dans cette version)." />
          <c:AppTextBox Label="Adresse email" Text="{Binding Email}" ContentType="Email" Watermark="vous@exemple.com" ErrorText="{Binding EmailError}" />
          <c:PrimaryButton HorizontalAlignment="Stretch" Content="Envoyer le lien" Command="{Binding SendCommand}" />
        </StackPanel>
        <StackPanel Spacing="18" IsVisible="{Binding IsSent}">
          <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource PrimaryLightBrush}" HorizontalAlignment="Left">
            <PathIcon Data="{StaticResource Icon.Send}" Width="30" Height="30" Foreground="{DynamicResource PrimaryBrush}" />
          </Border>
          <TextBlock Classes="h2" Text="Demande enregistrée" />
          <TextBlock Classes="body secondary" Text="Si un compte existe pour cette adresse, un lien de réinitialisation serait envoyé. Mode démonstration : aucun email n'est réellement envoyé. Le compte de démonstration utilise le mot de passe Demo123!" />
          <c:PrimaryButton HorizontalAlignment="Stretch" Content="Retour à la connexion" Command="{Binding BackToLoginCommand}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
