<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:BeninConnect.App.Core.Converters"
             xmlns:vm="using:BeninConnect.App.Features.Events.ViewModels"
             x:Class="BeninConnect.App.Features.Events.Components.EventTile"
             x:DataType="vm:EventItemViewModel">
  <!-- Vignette compacte (accueil, communauté). -->
  <Button Classes="bare" Width="230" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Title}">
    <Border Classes="card" Padding="0" ClipToBounds="True">
      <StackPanel>
        <Image Source="{Binding ImagePath, Converter={x:Static conv:AppConverters.AssetBitmap}}" Height="96" Stretch="UniformToFill" />
        <StackPanel Margin="12,10" Spacing="3">
          <TextBlock Classes="caption" FontSize="12" Text="{Binding ShortDateText}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="caption" FontSize="12" Text="{Binding City}" />
          <TextBlock Classes="caption" FontSize="12" Text="{Binding ParticipationLabel}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Button>
</UserControl>
