<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:BeninConnect.App.Core.Converters"
             xmlns:vm="using:BeninConnect.App.Features.Events.ViewModels"
             x:Class="BeninConnect.App.Features.Events.Components.EventCard"
             x:DataType="vm:EventItemViewModel">
  <Border Classes="card" Padding="0" ClipToBounds="True">
    <StackPanel>
      <Button Classes="bare" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Title}">
        <StackPanel>
          <Panel Height="140">
            <Image Source="{Binding ImagePath, Converter={x:Static conv:AppConverters.AssetBitmap}}" Stretch="UniformToFill" />
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="10,6" Margin="12"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
              <StackPanel>
                <TextBlock Text="{Binding Day}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Month}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </Panel>
          <StackPanel Margin="14,12,14,4" Spacing="4">
            <TextBlock Classes="caption" Text="{Binding Category}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Classes="secondary" Width="14" Height="14" Data="{StaticResource Icon.Clock}" />
              <TextBlock Classes="caption" Text="{Binding ShortDateText}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Classes="secondary" Width="14" Height="14" Data="{StaticResource Icon.MapMarker}" />
              <TextBlock Classes="caption" Text="{Binding City}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Button>
      <Grid ColumnDefinitions="*,Auto" Margin="14,6,14,12">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <PathIcon Classes="secondary" Width="14" Height="14" Data="{StaticResource Icon.Group}" />
          <TextBlock Classes="caption" Text="{Binding ParticipantsText}" />
        </StackPanel>
        <Button Grid.Column="1"
                MinHeight="36" Padding="16,6"
                Classes="primary"
                Classes.secondary="{Binding IsParticipating}"
                Content="{Binding ParticipationLabel}"
                Command="{Binding ToggleParticipationCommand}"
                IsEnabled="{Binding CanParticipate}" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
