<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:BeninConnect.App.Shared.Controls"
             xmlns:shell="using:BeninConnect.App.Shell"
             x:Class="BeninConnect.App.Shared.Components.BottomNavigationBar"
             x:DataType="shell:ShellViewModel">
  <Border Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="0,1,0,0"
          Padding="4,4,4,6">
    <Grid ColumnDefinitions="*,*,*,*,*">
      <Button Classes="tab" Classes.selected="{Binding IsHomeSelected}" Command="{Binding ShowHomeCommand}" AutomationProperties.Name="Accueil">
        <StackPanel Spacing="2" HorizontalAlignment="Center">
          <PathIcon Data="{StaticResource Icon.Home}" />
          <TextBlock Text="Accueil" HorizontalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="1" Classes="tab" Classes.selected="{Binding IsCommunitiesSelected}" Command="{Binding ShowCommunitiesCommand}" AutomationProperties.Name="Communautés">
        <StackPanel Spacing="2" HorizontalAlignment="Center">
          <PathIcon Data="{StaticResource Icon.Group}" />
          <TextBlock Text="Communautés" HorizontalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2" Classes="tab" Command="{Binding PublishCommand}" AutomationProperties.Name="Publier">
        <StackPanel Spacing="2" HorizontalAlignment="Center">
          <Border Width="40" Height="30" CornerRadius="10" Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center">
            <PathIcon Data="{StaticResource Icon.Plus}" Foreground="{DynamicResource OnPrimaryBrush}" Width="20" Height="20" />
          </Border>
          <TextBlock Text="Publier" HorizontalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="3" Classes="tab" Classes.selected="{Binding IsMessagesSelected}" Command="{Binding ShowMessagesCommand}" AutomationProperties.Name="Messages">
        <Panel>
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <PathIcon Data="{StaticResource Icon.Chat}" />
            <TextBlock Text="Messages" HorizontalAlignment="Center" />
          </StackPanel>
          <c:BadgeView Count="{Binding UnreadMessages}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="26,-4,0,0" />
        </Panel>
      </Button>
      <Button Grid.Column="4" Classes="tab" Classes.selected="{Binding IsProfileSelected}" Command="{Binding ShowProfileCommand}" AutomationProperties.Name="Profil">
        <StackPanel Spacing="2" HorizontalAlignment="Center">
          <PathIcon Data="{StaticResource Icon.Account}" />
          <TextBlock Text="Profil" HorizontalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>
  </Border>
</UserControl>
