<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BeninConnect.App.Shared.Components.EmptyState"
             x:Name="Root">
  <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="24,40" MaxWidth="320">
    <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource PrimaryLightBrush}" HorizontalAlignment="Center">
      <PathIcon Data="{Binding #Root.Icon}" Width="32" Height="32" Foreground="{DynamicResource PrimaryBrush}" />
    </Border>
    <TextBlock Classes="h3" Text="{Binding #Root.Title}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" />
    <TextBlock Classes="secondary" Text="{Binding #Root.Message}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" />
    <Button Classes="secondary"
            Margin="0,6,0,0"
            HorizontalAlignment="Center"
            Content="{Binding #Root.ActionText}"
            Command="{Binding #Root.ActionCommand}"
            IsVisible="{Binding #Root.ActionCommand, Converter={x:Static ObjectConverters.IsNotNull}}" />
  </StackPanel>
</UserControl>
