<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BeninConnect.App.Shared.Controls.PasswordField"
             x:Name="Root">
  <StackPanel Spacing="6">
    <TextBlock Classes="label"
               Text="{Binding #Root.Label}"
               IsVisible="{Binding #Root.Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <Grid>
      <TextBox Text="{Binding #Root.Text, Mode=TwoWay}"
               Watermark="{Binding #Root.Watermark}"
               PasswordChar="•"
               RevealPassword="{Binding #Root.IsRevealed}"
               Padding="14,12,52,12"
               Classes.error="{Binding #Root.ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               TextInputOptions.ContentType="Password"
               AutomationProperties.Name="{Binding #Root.Label}" />
      <Button Classes="icon"
              HorizontalAlignment="Right"
              Margin="0,0,4,0"
              Width="40" Height="40"
              Click="OnToggleReveal"
              AutomationProperties.Name="Afficher ou masquer le mot de passe">
        <Panel>
          <PathIcon Classes="secondary" Data="{StaticResource Icon.Eye}" IsVisible="{Binding !#Root.IsRevealed}" />
          <PathIcon Classes="secondary" Data="{StaticResource Icon.EyeOff}" IsVisible="{Binding #Root.IsRevealed}" />
        </Panel>
      </Button>
    </Grid>
    <TextBlock Classes="error"
               Text="{Binding #Root.ErrorText}"
               IsVisible="{Binding #Root.ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </StackPanel>
</UserControl>
