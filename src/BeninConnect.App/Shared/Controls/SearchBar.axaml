<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BeninConnect.App.Shared.Controls.SearchBar"
             x:Name="Root">
  <Grid>
    <TextBox Text="{Binding #Root.Text, Mode=TwoWay}"
             Watermark="{Binding #Root.Watermark}"
             Padding="44,12,44,12"
             CornerRadius="24"
             Background="{DynamicResource SurfaceBrush}"
             TextInputOptions.ContentType="Search"
             AutomationProperties.Name="{Binding #Root.Watermark}" />
    <PathIcon Classes="secondary small"
              Data="{StaticResource Icon.Search}"
              HorizontalAlignment="Left"
              Margin="16,0,0,0"
              IsHitTestVisible="False" />
    <Button Classes="icon"
            Width="36" Height="36"
            HorizontalAlignment="Right"
            Margin="0,0,6,0"
            Click="OnClear"
            IsVisible="{Binding #Root.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            AutomationProperties.Name="Effacer la recherche">
      <PathIcon Classes="secondary small" Data="{StaticResource Icon.Close}" />
    </Button>
  </Grid>
</UserControl>
