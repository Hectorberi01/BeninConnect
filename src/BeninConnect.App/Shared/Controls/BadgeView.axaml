<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BeninConnect.App.Shared.Controls.BadgeView"
             x:Name="Root"
             IsHitTestVisible="False">
  <Border Background="{DynamicResource ErrorBrush}"
          CornerRadius="9"
          MinWidth="18"
          Height="18"
          Padding="5,0"
          BorderBrush="{DynamicResource SurfaceBrush}"
          BorderThickness="2">
    <TextBlock Text="{Binding #Root.DisplayText}"
               Foreground="#FFFFFF"
               FontSize="10"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />
  </Border>
</UserControl>
