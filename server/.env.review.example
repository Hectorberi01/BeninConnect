# API de revue Apple / Google (service api-review, mode Review). Copier en .env.review sur le serveur, droits 600.
# Base SÉPARÉE de la production : un rôle PostgreSQL sans aucun droit sur la base de production.
#   CREATE ROLE beninconnect_review LOGIN PASSWORD '…';
#   CREATE DATABASE beninconnect_review OWNER beninconnect_review;
# Base sur le VPS : Host=host.docker.internal ; SSL Mode=Disable + Database__AllowInsecure=true
ConnectionStrings__Database=Host=host.docker.internal;Port=5432;Database=beninconnect_review;Username=beninconnect_review;Password=remplacer;SSL Mode=Disable
Database__AllowInsecure=true

# Clé DIFFÉRENTE de la production (openssl rand -base64 48) : un jeton de revue n'est jamais valable en production
Jwt__SigningKey=remplacer-par-une-cle-de-48-caracteres-au-moins

# Compte donné à Apple / Google (recréé à chaque remise à zéro). Mot de passe : 12 caractères au moins.
Review__AccountEmail=appreview@monbenin.com
Review__AccountPassword=remplacer

# Notifications push (même projet Expo que la production ; jeton seulement si « Enhanced Security » est activé)
# Push__ExpoAccessToken=
