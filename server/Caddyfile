# Caddy installé sur le VPS (apt install caddy) : HTTPS automatique Let's Encrypt.
# Déployé par Ansible (rôle web) dans /etc/caddy/sites/beninconnect.caddy, importé par /etc/caddy/Caddyfile.
api.monbenin.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Photos (10 Mo), pièces jointes (20 Mo), vidéos (60 Mo) ; marge pour l'en-tête multipart
	request_body {
		max_size 70MB
	}

	reverse_proxy 127.0.0.1:8080 {
		health_uri /health
		health_interval 30s
	}

	# Temps réel (/hubs/chat) : le jeton passe dans l'URL, masqué dans les journaux
	log {
		output file /var/log/caddy/api.log
		format filter {
			wrap json
			fields {
				request>uri query {
					replace access_token REDACTED
				}
			}
		}
	}
}

# Site public : accueil, support, confidentialité, conditions (dossier site/ copié dans /var/www/monbenin)
monbenin.com {
	encode zstd gzip
	root * /var/www/monbenin

	# Publications partagées (aperçu + boutons des stores) et fichiers d'ouverture dans l'app : servis par l'API
	@api path /post/* /.well-known/apple-app-site-association /.well-known/assetlinks.json
	handle @api {
		reverse_proxy 127.0.0.1:8080
	}

	handle {
		try_files {path} {path}/ {path}.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@static path /img/* /style.css
	header @static Cache-Control "public, max-age=86400"

	handle_errors {
		@notFound expression {err.status_code} == 404
		handle @notFound {
			rewrite * /404.html
			file_server
		}
	}

	log {
		output file /var/log/caddy/site.log
		format json
	}
}

# Console d'administration : admin-console/dist copié dans /var/www/admin.
# /api, /uploads et /health relayés vers l'API : même origine, pas de CORS.
admin.monbenin.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}

	handle /uploads/* {
		reverse_proxy 127.0.0.1:8080
	}

	handle /health {
		reverse_proxy 127.0.0.1:8080
	}

	handle {
		root * /var/www/admin
		# Fichiers Vite versionnés : cache long ; index.html toujours revalidé
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/admin.log
		format json
	}
}

www.monbenin.com {
	redir https://monbenin.com{uri} permanent
}
