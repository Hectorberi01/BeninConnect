# Caddy installé sur le VPS (apt install caddy) : HTTPS automatique Let's Encrypt.
#   sudo cp server/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
api.monbenin.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Photos : jusqu'à 10 Mo (marge pour l'en-tête multipart)
	request_body {
		max_size 12MB
	}

	reverse_proxy 127.0.0.1:8080 {
		health_uri /health
		health_interval 30s
	}

	log {
		output file /var/log/caddy/api.log
		format json
	}
}

# Site public : accueil, support et politique de confidentialité (dossier site/ copié dans /var/www/monbenin)
monbenin.com {
	encode zstd gzip
	root * /var/www/monbenin
	try_files {path} {path}/ {path}.html
	file_server
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

www.monbenin.com {
	redir https://monbenin.com{uri} permanent
}
