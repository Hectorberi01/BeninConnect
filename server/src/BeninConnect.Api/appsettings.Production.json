{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "InitializeOnStartup": true,
    "SeedDemoData": false
  },
  "Auth": {
    "FixedVerificationCode": null,
    "PasswordResetMinutes": 30
  },
  "Email": {
    "Provider": "smtp",
    "Port": 587,
    "EnableSsl": true,
    "FromName": "BéninConnect"
  },
  "Jwt": {
    "LifetimeDays": 7,
    "AdminLifetimeHours": 12
  },
  "RateLimiting": {
    "Enabled": true,
    "GlobalPerMinute": 600,
    "AuthPerMinute": 10,
    "UploadsPerHour": 60
  },
  "Media": {
    "Provider": "local",
    "Root": "/app/media",
    "S3": {
      "Region": "auto",
      "ForcePathStyle": true
    }
  }
}
