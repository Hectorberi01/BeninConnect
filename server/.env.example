# Copier en .env (jamais commité) puis remplacer chaque valeur.

# API publiée sur 127.0.0.1 uniquement ; Caddy (sur le VPS) assure HTTPS pour api.monbenin.com
API_PORT=8080
# Origines web autorisées (navigateur uniquement ; l'app iOS/Android n'en a pas besoin)
# CORS_ORIGIN_1=http://localhost:8081
# Inutile pour admin.monbenin.com : Caddy relaie /api sur le même domaine.

# Base PostgreSQL hébergée (Neon, Supabase, Scaleway, OVHcloud, Hetzner, Azure, AWS RDS...)
# Utiliser l'hôte DIRECT (pas le pooler PgBouncer : les migrations EF ont besoin d'une session).
DB_HOST=ep-xxxx.eu-central-1.aws.neon.tech
DB_PORT=5432
DB_NAME=beninconnect
DB_USER=beninconnect_app
DB_PASSWORD=remplacer-par-le-mot-de-passe-du-fournisseur
# Require = chiffré ; VerifyFull = chiffré + certificat vérifié (recommandé si le fournisseur utilise une CA publique)
DB_SSLMODE=Require
# Base sur le VPS (DB_HOST=host.docker.internal) ou réseau privé sans SSL : DB_SSLMODE=Disable et DB_ALLOW_INSECURE=true
DB_ALLOW_INSECURE=false
# Connexions max par instance de l'API (rester sous la limite du forfait)
DB_POOL_SIZE=20

# Photos, vidéos et pièces jointes : disque du serveur (volume media, sauvegardé chaque nuit)
MEDIA_PROVIDER=local
# Stockage S3 (Cloudflare R2, Hetzner, Scaleway, MinIO...) : copier d'abord les fichiers (server/tools/media-to-s3.sh),
# puis MEDIA_PROVIDER=s3 et remplir
# S3_SERVICE_URL=https://xxxxxxxx.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=beninconnect-media
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_CREATE_BUCKET=false
# Domaine public du bucket (CDN) : photos et vidéos servies sans passer par l'API. Vide = l'API relaie chaque fichier.
# S3_PUBLIC_BASE_URL=
# Bucket des pièces jointes des discussions, OBLIGATOIRE si le bucket principal est public (S3_PUBLIC_BASE_URL, domaine R2) :
# il doit rester privé. Vide = même bucket, préfixe private/.
# S3_PRIVATE_BUCKET=beninconnect-private

# Liens de partage https://monbenin.com/post/… ouverts directement dans l'app installée (sinon : page web avec liens des stores)
# APPLE_TEAM_ID : developer.apple.com > Account > Membership details > Team ID
# APPLE_TEAM_ID=
# ANDROID_CERT_SHA256 : Play Console > Test et publication > Intégrité de l'application > Certificat de la clé de signature (SHA-256)
# ANDROID_CERT_SHA256=

# Sauvegarde quotidienne de la base par l'API (heure UTC ; 01:00 = 02:00 à Paris l'hiver)
# BACKUP_DAILY_AT_UTC=01:00

# Copie des sauvegardes hors du serveur (même compte S3/R2 que ci-dessus) : bucket PRIVÉ dédié.
# Le jeton R2 (S3_ACCESS_KEY) doit avoir l'accès lecture/écriture sur ce bucket. Vide = pas de copie distante.
# S3_BACKUP_BUCKET=beninconnect-backups
# Copies distantes supprimées N jours après leur disparition du serveur (rotation locale : 7 jours, 4 semaines, 6 mois)
# BACKUP_OFFSITE_RETENTION_DAYS=90

# Signature des jetons : openssl rand -base64 48
JWT_SIGNING_KEY=remplacer-par-une-cle-aleatoire-de-48-octets

# Emails (codes de vérification, mot de passe oublié) : Resend (https://resend.com)
# Clé : Resend > API Keys (droit « Sending access ») ; domaine monbenin.com vérifié dans Resend > Domains
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_remplacer
EMAIL_FROM=no-reply@monbenin.com
EMAIL_FROM_NAME=BéninConnect
# Alternative SMTP : EMAIL_PROVIDER=smtp puis SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=re_remplacer

# Notifications push (Expo). Facultatif : seulement si « Enhanced Security for Push Notifications » est activé
# (expo.dev > projet > Credentials > Access tokens)
# EXPO_ACCESS_TOKEN=

# Premier SuperAdmin (créé seulement si aucun compte admin n'existe ; changer le mot de passe à la 1re connexion)
ADMIN_BOOTSTRAP_EMAIL=hector@hbatechettrade.com
ADMIN_BOOTSTRAP_PASSWORD=remplacer-10-caracteres-min-1

# Revue Apple / Google (docs/ENVIRONNEMENT_REVUE_APPLE.md) : ces comptes sont renvoyés vers l'API de revue.
# À activer SEULEMENT quand la version de l'application qui suit la redirection est publiée.
# REVIEW_EMAIL_1=appreview@monbenin.com
# REVIEW_EMAIL_2=playreview@monbenin.com
# REVIEW_API_URL=https://review-api.monbenin.com
