{
  "expo": {
    "name": "BeninConnect",
    "slug": "beninconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hbatech.beninconnect.rn",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "BéninConnect se connecte à l'API de développement sur votre réseau local.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "BéninConnect"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#087F5B",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hbatech.beninconnect.rn"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "BéninConnect accède à vos photos pour votre photo de profil, votre couverture et vos publications.",
          "cameraPermission": "BéninConnect utilise l'appareil photo pour prendre une photo de profil ou illustrer une publication.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#087F5B"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#087F5B"
        }
      ]
    ],
    "scheme": "beninconnect",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4a0ba136-2301-495e-abac-0be7e5ef4584"
      }
    },
    "owner": "berihectors-team"
  }
}
