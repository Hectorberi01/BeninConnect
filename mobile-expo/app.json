{
  "expo": {
    "name": "BeninConnect",
    "slug": "beninconnect",
    "version": "1.1.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4a0ba136-2301-495e-abac-0be7e5ef4584",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hbatech.beninconnect.rn",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "BéninConnect se connecte à l'API de développement sur votre réseau local.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "BéninConnect"
      },
      "associatedDomains": [
        "applinks:monbenin.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#087F5B",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hbatech.beninconnect.rn",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "monbenin.com",
              "pathPrefix": "/post/"
            },
            {
              "scheme": "https",
              "host": "monbenin.com",
              "pathPrefix": "/user/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "BéninConnect accède à vos photos pour votre photo de profil, votre couverture, vos publications et vos discussions.",
          "cameraPermission": "BéninConnect utilise l'appareil photo pour prendre une photo de profil, illustrer une publication ou l’envoyer dans une discussion.",
          "microphonePermission": "BéninConnect utilise le micro pour enregistrer les messages vocaux que vous envoyez dans vos discussions."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#087F5B"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#087F5B"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "BéninConnect utilise le micro pour enregistrer les messages vocaux que vous envoyez dans vos discussions."
        }
      ],
      [
        "./plugins/withAndroidAppName",
        {
          "name": "BéninConnect"
        }
      ]
    ],
    "scheme": "beninconnect",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4a0ba136-2301-495e-abac-0be7e5ef4584"
      }
    },
    "owner": "berihectors-team"
  }
}
